# Скопируйте в .env и заполните. Файл .env не коммитится.

# ---------- ключи внешних сервисов ----------
# Gemini (Google AI Studio). Нужен для описания кампуса со сносками.
# Без ключа описание собирается выдержками из Википедии и сайта вуза.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Flickr API (необязательно). Даёт фото с геометками под свободными лицензиями.
FLICKR_API_KEY=

# Контакт в User-Agent: правила Wikimedia и OSM требуют способ связаться с автором запросов.
CONTACT=https://github.com/zhomarterkhainar-svg/locus

# ---------- общее хранилище (необязательно, но сильно ускоряет повторные запросы) ----------
# Supabase: готовые профили, кэш карт и климата, отметки пользователей.
# SUPABASE_KEY — service_role ключ, он остаётся только на сервере.
SUPABASE_URL=
SUPABASE_KEY=

# ---------- модели (ONNX Runtime, качаются scripts/download_models.py) ----------
# clip_vitb32 (по умолчанию) или mobileclip_s0
CLIP_MODEL=clip_vitb32
MODELS_DIR=models
# 0 — по числу ядер. На бесплатном инстансе Render поставьте 2.
ONNX_THREADS=0
# На инстансе с 512 МБ памяти выключите арену аллокатора: ONNX_MEM_ARENA=false
ONNX_MEM_ARENA=true

# ---------- бюджеты времени ----------
# Полный бюджет сборки профиля в секундах (цель кейса — 30, сервис держится в 10).
TOTAL_BUDGET=10
MAX_DOWNLOADS=120
DOWNLOAD_CONCURRENCY=32

# ---------- прочее ----------
# Ограничение частоты: новых сборок профиля в минуту с одного IP
RATE_LIMIT_PER_MIN=12
# Кэш карт, климата и маршрутов (на бесплатных хостингах подходит /tmp)
CACHE_DIR=/tmp/candid-cache
# Прогрев кэша карт частых вузов при старте (на слабом инстансе лучше false)
PREWARM=true
# Домены фронтенда, которым разрешён доступ к API (через запятую)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
